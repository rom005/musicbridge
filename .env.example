# Server
PORT=3000
# HOST is optional; the app binds 0.0.0.0 by default.

# Spotify (required for conversion)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Admin (required)
ADMIN_PASSWORD=change-me
# Long random string so admin sessions survive redeploys.
# If unset, it falls back to ADMIN_PASSWORD (fine for local dev only).
SESSION_SECRET=

# Persistence
# Hostless: create + link a managed Redis database; it is injected as REDIS_URL.
# Leave REDIS_URL unset for local development -> uses the local file store in DATA_DIR.
# REDIS_URL=rediss://default:password@host:6379
DATA_DIR=./data

# Logging
LOG_LEVEL=info

# Set on Hostless so the admin session cookie uses the Secure flag.
# NODE_ENV=production
